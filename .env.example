# Smart Ladders Commerce — Environment example
#
# D-BKP-001 locked: production secrets live in 1Password Secrets Automation.
# This file is a placeholder template only. NEVER commit real secrets.
# `.env*` files are gitignored.
#
# For local dev: copy to .env.local and fill in dev-only values.
# For staging/production: read from 1Password via `op` CLI at runtime.

# ─────────────────────────────────────────────────────────────────
# DATABASE (local dev only — production via 1Password)
# ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartladders_dev

# ─────────────────────────────────────────────────────────────────
# Next.js / runtime
# ─────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────
# Default country (storefront only — never used for admin RBAC)
# Per D-COUNTRY-014: countries are dynamic, never hardcoded in business logic.
# This default exists only for the Phase 1 dev shell.
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_LOCALE=ar-sa

# ─────────────────────────────────────────────────────────────────
# Permission cache (D-CACHE-001 locked: Redis session-level cache)
# Phase 1 sprint 2+ wires the actual Redis connection.
# ─────────────────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────────
# 1Password (CI bootstrap only — D-BKP-001)
# OP_SERVICE_ACCOUNT_TOKEN is set in GitHub Actions Secrets, not here.
# ─────────────────────────────────────────────────────────────────
# OP_SERVICE_ACCOUNT_TOKEN=  # NEVER commit
